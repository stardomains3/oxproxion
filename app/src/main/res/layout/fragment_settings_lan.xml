<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="LAN Server"
        app:titleTextColor="?android:attr/textColorPrimary"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/is_backarrow" />

    <ScrollView
        android:id="@+id/lanScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="32dp"
        android:clipToPadding="false"
        >

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="24dp"
            app:strokeColor="@color/chestnut"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_save_lan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Save"
                    android:textColor="?android:attr/textColorPrimary"
                    app:strokeColor="@color/chestnut"
                    app:strokeWidth="1dp"
                    app:backgroundTint="?attr/colorSurface" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#1A000000" />
                <!-- Endpoint URL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Endpoint URL"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Example: http://10.0.0.23:11434"
                    android:textColor="#8A8A8A"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/lanUrlInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="?attr/colorSurface"
                    android:hint="Enter LAN endpoint URL"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/text_input_stroke_color"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="?android:attr/textColorSecondary"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_text_lan_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:imeOptions="actionDone"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <!-- TLS Security section: revealed + highlighted when https:// is typed -->
                <LinearLayout
                    android:id="@+id/tlsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginTop="10dp"
                    android:background="?attr/colorSurface"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Allow Insecure LAN Certificates (self-signed)"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/insecureLanTlsSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tlsWarningText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="If using HTTPS and its certificate is self-signed (typical for home servers), enable this or the connection will fail. Leave off if your server has a valid certificate."
                        android:textColor="#E5A00D"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#1A000000" />

                <!-- Provider -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Server Type"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/providerRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radio_ollama"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ollama"
                        android:textColor="?android:attr/textColorPrimary" />

                    <RadioButton
                        android:id="@+id/radio_lm_studio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LM Studio"
                        android:textColor="?android:attr/textColorPrimary" />

                    <RadioButton
                        android:id="@+id/radio_llama_cpp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="llama.cpp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <RadioButton
                        android:id="@+id/radio_mlx_lm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MLX LM"
                        android:textColor="?android:attr/textColorPrimary" />

                    <RadioButton
                        android:id="@+id/radio_hermes_agent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hermes Agent"
                        android:textColor="?android:attr/textColorPrimary" />

                    <RadioButton
                        android:id="@+id/radio_olmx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="oMLX"
                        android:textColor="?android:attr/textColorPrimary" />

                    <RadioButton
                        android:id="@+id/radio_nativ"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nativ"
                        android:textColor="?android:attr/textColorPrimary" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#1A000000" />

                <!-- API Key -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LAN API Key (optional)"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Enter if Required"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/text_input_stroke_color"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="?android:attr/textColorSecondary"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_text_lan_api_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>



            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
</LinearLayout>
